# Copy to .env and uncomment the profile you need:
#   cp .env.example .env
#
# Config is baked at compile time via NX_* (see crates/mezon-store/src/config.rs).
# Rebuild after changing .env: `just run` / `just release`.
#
# With no .env (or all vars commented out), dev_defaults() in config.rs is used.

# ── Development (optional explicit override; same as dev_defaults()) ─────────────
# NX_CHAT_APP_API_HOST=dev-mezon.nccsoft.vn
# NX_CHAT_APP_API_PORT=8088
# NX_CHAT_APP_API_KEY=defaultkey
# NX_CHAT_APP_API_GW_HOST=dev-mezon.nccsoft.vn
# NX_CHAT_APP_API_GW_PORT=8088
# NX_CHAT_APP_TCP_PORT=7349
# NX_CHAT_APP_STREAM_WS_URL=wss://stn.nccsoft.vn
# NX_CHAT_APP_MEET_WS_URL=wss://meet.nccsoft.vn
# NX_BASE_IMG_URL=https://cdn.komu.vn
# NX_UPLOAD_IMG_URL=https://cdn-api.mezon.ai
# NX_PROFILE_IMG_URL=https://profile.mezon.ai
# NX_IMGPROXY_BASE_URL=https://dev-imgproxy.nccsoft.vn
# NX_IMGPROXY_KEY=_AEhOrrckkG-NjqIdVLtzc-dtLFuE4u6ClM0P46ICEY

# GIF picker (Klipy). Without a key the GIF panel stays empty — the key is part of
# the request path, so an empty value produces a 404 on every call.
# NX_CHAT_APP_API_KLIPY_KEY=
# NX_CHAT_APP_API_KLIPY_URL=https://api.klipy.com/api/v1
